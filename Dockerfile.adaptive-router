FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Adaptive Router: Lightweight intelligent routing service
# Acts as Edge Gateway for Stigma Fabric
COPY adaptive_router.py ./
COPY requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt

ENV PORT=8011
EXPOSE 8011

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:8011/health || exit 1

CMD ["python", "adaptive_router.py"]
