[Unit]
Description=Kloud ASI Trinity Heavy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kloud
Group=kloud
WorkingDirectory=/opt/kloud
Environment=ASI_MODE=alba
EnvironmentFile=-/etc/kloud/asi_trinity.env
ExecStart=/opt/kloud/asi_trinity
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
