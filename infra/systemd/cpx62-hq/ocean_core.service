[Unit]
Description=Kloud Ocean Core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kloud
Group=kloud
WorkingDirectory=/opt/kloud
EnvironmentFile=-/etc/kloud/ocean_core.env
ExecStart=/opt/kloud/ocean_core --config /etc/kloud/ocean_core.toml
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
