[Unit]
Description=Kloud Telemetry Collector Replica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kloud
Group=kloud
WorkingDirectory=/opt/kloud
EnvironmentFile=-/etc/kloud/telemetry_collector_replica.env
ExecStart=/opt/kloud/telemetry_collector
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
