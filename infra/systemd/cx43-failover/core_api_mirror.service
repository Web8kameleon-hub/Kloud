[Unit]
Description=Kloud Core API Mirror
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kloud
Group=kloud
WorkingDirectory=/opt/kloud
EnvironmentFile=-/etc/kloud/core_api_mirror.env
ExecStart=/opt/kloud/core_api --config /etc/kloud/core_api.toml
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
