FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY nodedb_control_plane_api.py /app/
COPY nodendb_stigma.py /app/
COPY nodendb_kloud_integration.py /app/

RUN pip install --no-cache-dir fastapi uvicorn httpx "pydantic>=2,<3"

EXPOSE 9090

CMD ["uvicorn", "nodedb_control_plane_api:app", "--host", "0.0.0.0", "--port", "9090"]