[Unit]
Description=Kloud Node Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/kloud
Environment=NODE_ID=1
Environment=LISTEN_PORT=8080
Environment=PEERS=
Environment=MESH_HEALTHCHECK_INTERVAL_MS=600000
Environment=MESH_HEALTHCHECK_TIMEOUT_MS=1200
Environment=KLOUD_PUBLIC_HOST=46.62.210.251
Environment=KLOUD_BRIDGE_PORT=8889
Environment=KLOUD_RUNTIME_PORT=9080
Environment=KLOUD_GOSSIP_PORT=9001
ExecStart=/opt/kloud/target/release/node
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

