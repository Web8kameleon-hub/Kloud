[Unit]
Description=Kloud Node Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/kloud
Environment=NODE_ID=1
Environment=LISTEN_PORT=8080
Environment=PEERS=2:91.98.47.131:8080,3:62.238.21.125:8000,4:37.27.216.254:8000
Environment=MESH_HEALTHCHECK_INTERVAL_MS=600000
Environment=MESH_HEALTHCHECK_TIMEOUT_MS=1200
Environment=CLISONIX_PUBLIC_HOST=91.98.47.131
Environment=CLISONIX_BRIDGE_PORT=8889
Environment=CLISONIX_RUNTIME_PORT=9080
Environment=CLISONIX_GOSSIP_PORT=9001
ExecStart=/opt/kloud/target/release/node
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
