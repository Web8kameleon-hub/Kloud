# ============================================
# KLOUD - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control!

# ---- Server / Deployment ----
HETZNER_IP=46.224.203.89
DEPLOY_PATH=/opt/kloud
SERVER_USER=root

# ---- Service Ports ----
PORT_WEB=3000
PORT_API=8000
PORT_OCEAN=8030
PORT_ALBA=5555
PORT_ALBI=6680
PORT_JONA=7777
PORT_ASI=9094
PORT_CYCLE=8050
PORT_LIAM=8062
PORT_ALDA=8063
PORT_ALPHABET=8061
PORT_AGIEM=9300

# ---- CLX / CLX.I (Local Inference) ----
CLX_HOST=localhost
CLX_PORT=11434
CLX_BASE_URL=http://localhost:11434
CLX_MODEL=clx
CLX_I_HOST=localhost
CLX_I_BASE_URL=http://localhost:4444
# STRICT RULES - DO NOT CHANGE THESE VALUES!
CLX_KEEP_ALIVE=5m
CLX_NUM_PREDICT=4096
CLX_NUM_CTX=8192

# ---- API Configuration ----
API_SECRET_KEY=your-secret-key-here
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=key1,key2,key3

# ---- JWT ----
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ---- Database ----
POSTGRES_USER=kloud
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=klouddb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kloud:password@localhost:5432/klouddb

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://default:password@localhost:6379/0

# ---- Neo4j ----
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_AUTH=neo4j/your-neo4j-password

# ---- Vector DB ----
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-key

# ---- InfluxDB (Time Series) ----
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=kloud
INFLUXDB_BUCKET=metrics
INFLUXDB_TOKEN=your-influxdb-token

# ---- MinIO Storage ----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false

# ---- Keycloak Auth ----
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=kloud
KEYCLOAK_CLIENT_ID=kloud-app
KEYCLOAK_CLIENT_SECRET=your-keycloak-secret

