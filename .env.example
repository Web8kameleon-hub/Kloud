ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004

# ---- Auth & Billing Public/Internal Policy ----
# Public auth mode: google_only | mixed
AUTH_PUBLIC_MODE=mixed
# Runtime auth provider: internal | clerk
AUTH_PROVIDER=internal
# Internal auth channels
AUTH_SMS_ENABLED=true
AUTH_EMAIL_OTP_ENABLED=true
AUTH_GOOGLE_OAUTH_ENABLED=true
# Google OAuth (for /api/internal-auth/google/*)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# External providers disabled by policy
AUTH_CLERK_ENABLED=false
AUTH_TWITTER_ENABLED=false
# Required for internal-only auth operations (register/phone login)
INTERNAL_AUTH_KEY=replace-with-strong-internal-auth-key
# Required for internal-only billing operations via X-Kloud-Internal-Key header
INTERNAL_API_KEY=replace-with-strong-internal-api-key
# Public billing exposure controls
BILLING_PUBLIC_STRIPE=true
BILLING_PUBLIC_PAYPAL=false
BILLING_PUBLIC_SEPA=false

# Public domains
PRIMARY_DOMAIN=clisonix.ai
CLX_DOMAIN=clx.clisonix.ai
HELLO_LITE_DOMAIN=lite.clisonix.ai

# LinkedIn API Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=urn:li:organization:111866162

# ---- WWWMMM Fluid (Global Auto) ----
# New-first resonant profile across services, automatic old-modus fallback on mismatch.
FLUID_AUTOSTART=true
WWWMMM_AUTORUN=true
PRIMARY_RESONANT_PROFILE=wwwmmm-ndb-stigma-tide-rezonance-nanogrid
ADAPTIVE_COMPAT_MODE=true
OLD_MODE_ON_MISMATCH=true
RESONANT_WRITE_MODE=new-first
RESONANT_FALLBACK_MODE=old-modus

