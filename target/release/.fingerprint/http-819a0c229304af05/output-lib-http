":1},{"text":"    /// Indicates which headers can be exposed as part of the response by","highlight_start":1,"highlight_end":74},{"text":"    /// listing their names.","highlight_start":1,"highlight_end":29},{"text":"    (AccessControlExposeHeaders, ACCESS_CONTROL_EXPOSE_HEADERS, b\"access-control-expose-headers\");","highlight_start":1,"highlight_end":99},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates how long the results of a preflight request can be cached.","highlight_start":1,"highlight_end":77},{"text":"    (AccessControlMaxAge, ACCESS_CONTROL_MAX_AGE, b\"access-control-max-age\");","highlight_start":1,"highlight_end":78},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Informs the server which HTTP headers will be used when an actual","highlight_start":1,"highlight_end":74},{"text":"    /// request is made.","highlight_start":1,"highlight_end":25},{"text":"    (AccessControlRequestHeaders, ACCESS_CONTROL_REQUEST_HEADERS, b\"access-control-request-headers\");","highlight_start":1,"highlight_end":102},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Informs the server know which HTTP method will be used when the actual","highlight_start":1,"highlight_end":79},{"text":"    /// request is made.","highlight_start":1,"highlight_end":25},{"text":"    (AccessControlRequestMethod, ACCESS_CONTROL_REQUEST_METHOD, b\"access-control-request-method\");","highlight_start":1,"highlight_end":99},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates the time in seconds the object has been in a proxy cache.","highlight_start":1,"highlight_end":76},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The Age header is usually close to zero. If it is Age: 0, it was","highlight_start":1,"highlight_end":73},{"text":"    /// probably just fetched from the origin server; otherwise It is usually","highlight_start":1,"highlight_end":78},{"text":"    /// calculated as a difference between the proxy's current date and the Date","highlight_start":1,"highlight_end":81},{"text":"    /// general header included in the HTTP response.","highlight_start":1,"highlight_end":54},{"text":"    (Age, AGE, b\"age\");","highlight_start":1,"highlight_end":24},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Lists the set of methods support by a resource.","highlight_start":1,"highlight_end":56},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header must be sent if the server responds with a 405 Method Not","highlight_start":1,"highlight_end":78},{"text":"    /// Allowed status code to indicate which request methods can be used. An","highlight_start":1,"highlight_end":78},{"text":"    /// empty Allow header indicates that the resource allows no request","highlight_start":1,"highlight_end":73},{"text":"    /// methods, which might occur temporarily for a given resource, for","highlight_start":1,"highlight_end":73},{"text":"    /// example.","highlight_start":1,"highlight_end":17},{"text":"    (Allow, ALLOW, b\"allow\");","highlight_start":1,"highlight_end":30},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Advertises the availability of alternate services to clients.","highlight_start":1,"highlight_end":70},{"text":"    (AltSvc, ALT_SVC, b\"alt-svc\");","highlight_start":1,"highlight_end":35},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains the credentials to authenticate a user agent with a server.","highlight_start":1,"highlight_end":77},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Usually this header is included after the server has responded with a","highlight_start":1,"highlight_end":78},{"text":"    /// 401 Unauthorized status and the WWW-Authenticate header.","highlight_start":1,"highlight_end":65},{"text":"    (Authorization, AUTHORIZATION, b\"authorization\");","highlight_start":1,"highlight_end":54},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Specifies directives for caching mechanisms in both requests and","highlight_start":1,"highlight_end":73},{"text":"    /// responses.","highlight_start":1,"highlight_end":19},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Caching directives are unidirectional, meaning that a given directive in","highlight_start":1,"highlight_end":81},{"text":"    /// a request is not implying that the same directive is to be given in the","highlight_start":1,"highlight_end":80},{"text":"    /// response.","highlight_start":1,"highlight_end":18},{"text":"    (CacheControl, CACHE_CONTROL, b\"cache-control\");","highlight_start":1,"highlight_end":53},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates how caches have handled a response and its corresponding request.","highlight_start":1,"highlight_end":84},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// See [RFC 9211](https://www.rfc-editor.org/rfc/rfc9211.html).","highlight_start":1,"highlight_end":69},{"text":"    (CacheStatus, CACHE_STATUS, b\"cache-status\");","highlight_start":1,"highlight_end":50},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Specifies directives that allow origin servers to control the behavior of CDN caches","highlight_start":1,"highlight_end":93},{"text":"    /// interposed between them and clients separately from other caches that might handle the","highlight_start":1,"highlight_end":95},{"text":"    /// response.","highlight_start":1,"highlight_end":18},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// See [RFC 9213](https://www.rfc-editor.org/rfc/rfc9213.html).","highlight_start":1,"highlight_end":69},{"text":"    (CdnCacheControl, CDN_CACHE_CONTROL, b\"cdn-cache-control\");","highlight_start":1,"highlight_end":64},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Controls whether or not the network connection stays open after the","highlight_start":1,"highlight_end":76},{"text":"    /// current transaction finishes.","highlight_start":1,"highlight_end":38},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If the value sent is keep-alive, the connection is persistent and not","highlight_start":1,"highlight_end":78},{"text":"    /// closed, allowing for subsequent requests to the same server to be done.","highlight_start":1,"highlight_end":80},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Except for the standard hop-by-hop headers (Keep-Alive,","highlight_start":1,"highlight_end":64},{"text":"    /// Transfer-Encoding, TE, Connection, Trailer, Upgrade, Proxy-Authorization","highlight_start":1,"highlight_end":81},{"text":"    /// and Proxy-Authenticate), any hop-by-hop headers used by the message must","highlight_start":1,"highlight_end":81},{"text":"    /// be listed in the Connection header, so that the first proxy knows he has","highlight_start":1,"highlight_end":81},{"text":"    /// to consume them and not to forward them further. Standard hop-by-hop","highlight_start":1,"highlight_end":77},{"text":"    /// headers can be listed too (it is often the case of Keep-Alive, but this","highlight_start":1,"highlight_end":80},{"text":"    /// is not mandatory.","highlight_start":1,"highlight_end":26},{"text":"    (Connection, CONNECTION, b\"connection\");","highlight_start":1,"highlight_end":45},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates if the content is expected to be displayed inline.","highlight_start":1,"highlight_end":69},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// In a regular HTTP response, the Content-Disposition response header is a","highlight_start":1,"highlight_end":81},{"text":"    /// header indicating if the content is expected to be displayed inline in","highlight_start":1,"highlight_end":79},{"text":"    /// the browser, that is, as a Web page or as part of a Web page, or as an","highlight_start":1,"highlight_end":79},{"text":"    /// attachment, that is downloaded and saved locally.","highlight_start":1,"highlight_end":58},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// In a multipart/form-data body, the HTTP Content-Disposition general","highlight_start":1,"highlight_end":76},{"text":"    /// header is a header that can be used on the subpart of a multipart body","highlight_start":1,"highlight_end":79},{"text":"    /// to give information about the field it applies to. The subpart is","highlight_start":1,"highlight_end":74},{"text":"    /// delimited by the boundary defined in the Content-Type header. Used on","highlight_start":1,"highlight_end":78},{"text":"    /// the body itself, Content-Disposition has no effect.","highlight_start":1,"highlight_end":60},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The Content-Disposition header is defined in the larger context of MIME","highlight_start":1,"highlight_end":80},{"text":"    /// messages for e-mail, but only a subset of the possible parameters apply","highlight_start":1,"highlight_end":80},{"text":"    /// to HTTP forms and POST requests. Only the value form-data, as well as","highlight_start":1,"highlight_end":78},{"text":"    /// the optional directive name and filename, can be used in the HTTP","highlight_start":1,"highlight_end":74},{"text":"    /// context.","highlight_start":1,"highlight_end":17},{"text":"    (ContentDisposition, CONTENT_DISPOSITION, b\"content-disposition\");","highlight_start":1,"highlight_end":71},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Used to compress the media-type.","highlight_start":1,"highlight_end":41},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// When present, its value indicates what additional content encoding has","highlight_start":1,"highlight_end":79},{"text":"    /// been applied to the entity-body. It lets the client know, how to decode","highlight_start":1,"highlight_end":80},{"text":"    /// in order to obtain the media-type referenced by the Content-Type header.","highlight_start":1,"highlight_end":81},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// It is recommended to compress data as much as possible and therefore to","highlight_start":1,"highlight_end":80},{"text":"    /// use this field, but some types of resources, like jpeg images, are","highlight_start":1,"highlight_end":75},{"text":"    /// already compressed.  Sometimes using additional compression doesn't","highlight_start":1,"highlight_end":76},{"text":"    /// reduce payload size and can even make the payload longer.","highlight_start":1,"highlight_end":66},{"text":"    (ContentEncoding, CONTENT_ENCODING, b\"content-encoding\");","highlight_start":1,"highlight_end":62},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Used to describe the languages intended for the audience.","highlight_start":1,"highlight_end":66},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header allows a user to differentiate according to the users' own","highlight_start":1,"highlight_end":79},{"text":"    /// preferred language. For example, if \"Content-Language: de-DE\" is set, it","highlight_start":1,"highlight_end":81},{"text":"    /// says that the document is intended for German language speakers","highlight_start":1,"highlight_end":72},{"text":"    /// (however, it doesn't indicate the document is written in German. For","highlight_start":1,"highlight_end":77},{"text":"    /// example, it might be written in English as part of a language course for","highlight_start":1,"highlight_end":81},{"text":"    /// German speakers).","highlight_start":1,"highlight_end":26},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If no Content-Language is specified, the default is that the content is","highlight_start":1,"highlight_end":80},{"text":"    /// intended for all language audiences. Multiple language tags are also","highlight_start":1,"highlight_end":77},{"text":"    /// possible, as well as applying the Content-Language header to various","highlight_start":1,"highlight_end":77},{"text":"    /// media types and not only to textual documents.","highlight_start":1,"highlight_end":55},{"text":"    (ContentLanguage, CONTENT_LANGUAGE, b\"content-language\");","highlight_start":1,"highlight_end":62},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates the size of the entity-body.","highlight_start":1,"highlight_end":47},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The header value must be a decimal indicating the number of octets sent","highlight_start":1,"highlight_end":80},{"text":"    /// to the recipient.","highlight_start":1,"highlight_end":26},{"text":"    (ContentLength, CONTENT_LENGTH, b\"content-length\");","highlight_start":1,"highlight_end":56},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates an alternate location for the returned data.","highlight_start":1,"highlight_end":63},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The principal use case is to indicate the URL of the resource","highlight_start":1,"highlight_end":70},{"text":"    /// transmitted as the result of content negotiation.","highlight_start":1,"highlight_end":58},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Location and Content-Location are different: Location indicates the","highlight_start":1,"highlight_end":76},{"text":"    /// target of a redirection (or the URL of a newly created document), while","highlight_start":1,"highlight_end":80},{"text":"    /// Content-Location indicates the direct URL to use to access the resource,","highlight_start":1,"highlight_end":81},{"text":"    /// without the need of further content negotiation. Location is a header","highlight_start":1,"highlight_end":78},{"text":"    /// associated with the response, while Content-Location is associated with","highlight_start":1,"highlight_end":80},{"text":"    /// the entity returned.","highlight_start":1,"highlight_end":29},{"text":"    (ContentLocation, CONTENT_LOCATION, b\"content-location\");","highlight_start":1,"highlight_end":62},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates where in a full body message a partial message belongs.","highlight_start":1,"highlight_end":74},{"text":"    (ContentRange, CONTENT_RANGE, b\"content-range\");","highlight_start":1,"highlight_end":53},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Allows controlling resources the user agent is allowed to load for a","highlight_start":1,"highlight_end":77},{"text":"    /// given page.","highlight_start":1,"highlight_end":20},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// With a few exceptions, policies mostly involve specifying server origins","highlight_start":1,"highlight_end":81},{"text":"    /// and script endpoints. This helps guard against cross-site scripting","highlight_start":1,"highlight_end":76},{"text":"    /// attacks (XSS).","highlight_start":1,"highlight_end":23},{"text":"    (ContentSecurityPolicy, CONTENT_SECURITY_POLICY, b\"content-security-policy\");","highlight_start":1,"highlight_end":82},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Allows experimenting with policies by monitoring their effects.","highlight_start":1,"highlight_end":72},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The HTTP Content-Security-Policy-Report-Only response header allows web","highlight_start":1,"highlight_end":80},{"text":"    /// developers to experiment with policies by monitoring (but not enforcing)","highlight_start":1,"highlight_end":81},{"text":"    /// their effects. These violation reports consist of JSON documents sent","highlight_start":1,"highlight_end":78},{"text":"    /// via an HTTP POST request to the specified URI.","highlight_start":1,"highlight_end":55},{"text":"    (ContentSecurityPolicyReportOnly, CONTENT_SECURITY_POLICY_REPORT_ONLY, b\"content-security-policy-report-only\");","highlight_start":1,"highlight_end":116},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Used to indicate the media type of the resource.","highlight_start":1,"highlight_end":57},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// In responses, a Content-Type header tells the client what the content","highlight_start":1,"highlight_end":78},{"text":"    /// type of the returned content actually is. Browsers will do MIME sniffing","highlight_start":1,"highlight_end":81},{"text":"    /// in some cases and will not necessarily follow the value of this header;","highlight_start":1,"highlight_end":80},{"text":"    /// to prevent this behavior, the header X-Content-Type-Options can be set","highlight_start":1,"highlight_end":79},{"text":"    /// to nosniff.","highlight_start":1,"highlight_end":20},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// In requests, (such as POST or PUT), the client tells the server what","highlight_start":1,"highlight_end":77},{"text":"    /// type of data is actually sent.","highlight_start":1,"highlight_end":39},{"text":"    (ContentType, CONTENT_TYPE, b\"content-type\");","highlight_start":1,"highlight_end":50},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains stored HTTP cookies previously sent by the server with the","highlight_start":1,"highlight_end":76},{"text":"    /// Set-Cookie header.","highlight_start":1,"highlight_end":27},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The Cookie header might be omitted entirely, if the privacy setting of","highlight_start":1,"highlight_end":79},{"text":"    /// the browser are set to block them, for example.","highlight_start":1,"highlight_end":56},{"text":"    (Cookie, COOKIE, b\"cookie\");","highlight_start":1,"highlight_end":33},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates the client's tracking preference.","highlight_start":1,"highlight_end":52},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header lets users indicate whether they would prefer privacy rather","highlight_start":1,"highlight_end":81},{"text":"    /// than personalized content.","highlight_start":1,"highlight_end":35},{"text":"    (Dnt, DNT, b\"dnt\");","highlight_start":1,"highlight_end":24},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains the date and time at which the message was originated.","highlight_start":1,"highlight_end":72},{"text":"    (Date, DATE, b\"date\");","highlight_start":1,"highlight_end":27},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Identifier for a specific version of a resource.","highlight_start":1,"highlight_end":57},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header allows caches to be more efficient, and saves bandwidth, as","highlight_start":1,"highlight_end":80},{"text":"    /// a web server does not need to send a full response if the content has","highlight_start":1,"highlight_end":78},{"text":"    /// not changed. On the other side, if the content has changed, etags are","highlight_start":1,"highlight_end":78},{"text":"    /// useful to help prevent simultaneous updates of a resource from","highlight_start":1,"highlight_end":71},{"text":"    /// overwriting each other (\"mid-air collisions\").","highlight_start":1,"highlight_end":55},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If the resource at a given URL changes, a new Etag value must be","highlight_start":1,"highlight_end":73},{"text":"    /// generated. Etags are therefore similar to fingerprints and might also be","highlight_start":1,"highlight_end":81},{"text":"    /// used for tracking purposes by some servers. A comparison of them allows","highlight_start":1,"highlight_end":80},{"text":"    /// to quickly determine whether two representations of a resource are the","highlight_start":1,"highlight_end":79},{"text":"    /// same, but they might also be set to persist indefinitely by a tracking","highlight_start":1,"highlight_end":79},{"text":"    /// server.","highlight_start":1,"highlight_end":16},{"text":"    (Etag, ETAG, b\"etag\");","highlight_start":1,"highlight_end":27},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates expectations that need to be fulfilled by the server in order","highlight_start":1,"highlight_end":80},{"text":"    /// to properly handle the request.","highlight_start":1,"highlight_end":40},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The only expectation defined in the specification is Expect:","highlight_start":1,"highlight_end":69},{"text":"    /// 100-continue, to which the server shall respond with:","highlight_start":1,"highlight_end":62},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * 100 if the information contained in the header is sufficient to cause","highlight_start":1,"highlight_end":80},{"text":"    /// an immediate success,","highlight_start":1,"highlight_end":30},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * 417 (Expectation Failed) if it cannot meet the expectation; or any","highlight_start":1,"highlight_end":77},{"text":"    /// other 4xx status otherwise.","highlight_start":1,"highlight_end":36},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// For example, the server may reject a request if its Content-Length is","highlight_start":1,"highlight_end":78},{"text":"    /// too large.","highlight_start":1,"highlight_end":19},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// No common browsers send the Expect header, but some other clients such","highlight_start":1,"highlight_end":79},{"text":"    /// as cURL do so by default.","highlight_start":1,"highlight_end":34},{"text":"    (Expect, EXPECT, b\"expect\");","highlight_start":1,"highlight_end":33},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains the date/time after which the response is considered stale.","highlight_start":1,"highlight_end":77},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Invalid dates, like the value 0, represent a date in the past and mean","highlight_start":1,"highlight_end":79},{"text":"    /// that the resource is already expired.","highlight_start":1,"highlight_end":46},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If there is a Cache-Control header with the \"max-age\" or \"s-max-age\"","highlight_start":1,"highlight_end":77},{"text":"    /// directive in the response, the Expires header is ignored.","highlight_start":1,"highlight_end":66},{"text":"    (Expires, EXPIRES, b\"expires\");","highlight_start":1,"highlight_end":36},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains information from the client-facing side of proxy servers that","highlight_start":1,"highlight_end":79},{"text":"    /// is altered or lost when a proxy is involved in the path of the request.","highlight_start":1,"highlight_end":80},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The alternative and de-facto standard versions of this header are the","highlight_start":1,"highlight_end":78},{"text":"    /// X-Forwarded-For, X-Forwarded-Host and X-Forwarded-Proto headers.","highlight_start":1,"highlight_end":73},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header is used for debugging, statistics, and generating","highlight_start":1,"highlight_end":70},{"text":"    /// location-dependent content and by design it exposes privacy sensitive","highlight_start":1,"highlight_end":78},{"text":"    /// information, such as the IP address of the client. Therefore the user's","highlight_start":1,"highlight_end":80},{"text":"    /// privacy must be kept in mind when deploying this header.","highlight_start":1,"highlight_end":65},{"text":"    (Forwarded, FORWARDED, b\"forwarded\");","highlight_start":1,"highlight_end":42},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains an Internet email address for a human user who controls the","highlight_start":1,"highlight_end":77},{"text":"    /// requesting user agent.","highlight_start":1,"highlight_end":31},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If you are running a robotic user agent (e.g. a crawler), the From","highlight_start":1,"highlight_end":75},{"text":"    /// header should be sent, so you can be contacted if problems occur on","highlight_start":1,"highlight_end":76},{"text":"    /// servers, such as if the robot is sending excessive, unwanted, or invalid","highlight_start":1,"highlight_end":81},{"text":"    /// requests.","highlight_start":1,"highlight_end":18},{"text":"    (From, FROM, b\"from\");","highlight_start":1,"highlight_end":27},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Specifies the domain name of the server and (optionally) the TCP port","highlight_start":1,"highlight_end":78},{"text":"    /// number on which the server is listening.","highlight_start":1,"highlight_end":49},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// If no port is given, the default port for the service requested (e.g.,","highlight_start":1,"highlight_end":79},{"text":"    /// \"80\" for an HTTP URL) is implied.","highlight_start":1,"highlight_end":42},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// A Host header field must be sent in all HTTP/1.1 request messages. A 400","highlight_start":1,"highlight_end":81},{"text":"    /// (Bad Request) status code will be sent to any HTTP/1.1 request message","highlight_start":1,"highlight_end":79},{"text":"    /// that lacks a Host header field or contains more than one.","highlight_start":1,"highlight_end":66},{"text":"    (Host, HOST, b\"host\");","highlight_start":1,"highlight_end":27},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Makes a request conditional based on the E-Tag.","highlight_start":1,"highlight_end":56},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// For GET and HEAD methods, the server will send back the requested","highlight_start":1,"highlight_end":74},{"text":"    /// resource only if it matches one of the listed ETags. For PUT and other","highlight_start":1,"highlight_end":79},{"text":"    /// non-safe methods, it will only upload the resource in this case.","highlight_start":1,"highlight_end":73},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The comparison with the stored ETag uses the strong comparison","highlight_start":1,"highlight_end":71},{"text":"    /// algorithm, meaning two files are considered identical byte to byte only.","highlight_start":1,"highlight_end":81},{"text":"    /// This is weakened when the  W/ prefix is used in front of the ETag.","highlight_start":1,"highlight_end":75},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// There are two common use cases:","highlight_start":1,"highlight_end":40},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * For GET and HEAD methods, used in combination with an Range header, it","highlight_start":1,"highlight_end":81},{"text":"    /// can guarantee that the new ranges requested comes from the same resource","highlight_start":1,"highlight_end":81},{"text":"    /// than the previous one. If it doesn't match, then a 416 (Range Not","highlight_start":1,"highlight_end":74},{"text":"    /// Satisfiable) response is returned.","highlight_start":1,"highlight_end":43},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * For other methods, and in particular for PUT, If-Match can be used to","highlight_start":1,"highlight_end":80},{"text":"    /// prevent the lost update problem. It can check if the modification of a","highlight_start":1,"highlight_end":79},{"text":"    /// resource that the user wants to upload will not override another change","highlight_start":1,"highlight_end":80},{"text":"    /// that has been done since the original resource was fetched. If the","highlight_start":1,"highlight_end":75},{"text":"    /// request cannot be fulfilled, the 412 (Precondition Failed) response is","highlight_start":1,"highlight_end":79},{"text":"    /// returned.","highlight_start":1,"highlight_end":18},{"text":"    (IfMatch, IF_MATCH, b\"if-match\");","highlight_start":1,"highlight_end":38},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Makes a request conditional based on the modification date.","highlight_start":1,"highlight_end":68},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The If-Modified-Since request HTTP header makes the request conditional:","highlight_start":1,"highlight_end":81},{"text":"    /// the server will send back the requested resource, with a 200 status,","highlight_start":1,"highlight_end":77},{"text":"    /// only if it has been last modified after the given date. If the request","highlight_start":1,"highlight_end":79},{"text":"    /// has not been modified since, the response will be a 304 without any","highlight_start":1,"highlight_end":76},{"text":"    /// body; the Last-Modified header will contain the date of last","highlight_start":1,"highlight_end":69},{"text":"    /// modification. Unlike If-Unmodified-Since, If-Modified-Since can only be","highlight_start":1,"highlight_end":80},{"text":"    /// used with a GET or HEAD.","highlight_start":1,"highlight_end":33},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// When used in combination with If-None-Match, it is ignored, unless the","highlight_start":1,"highlight_end":79},{"text":"    /// server doesn't support If-None-Match.","highlight_start":1,"highlight_end":46},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The most common use case is to update a cached entity that has no","highlight_start":1,"highlight_end":74},{"text":"    /// associated ETag.","highlight_start":1,"highlight_end":25},{"text":"    (IfModifiedSince, IF_MODIFIED_SINCE, b\"if-modified-since\");","highlight_start":1,"highlight_end":64},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Makes a request conditional based on the E-Tag.","highlight_start":1,"highlight_end":56},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The If-None-Match HTTP request header makes the request conditional. For","highlight_start":1,"highlight_end":81},{"text":"    /// GET and HEAD methods, the server will send back the requested resource,","highlight_start":1,"highlight_end":80},{"text":"    /// with a 200 status, only if it doesn't have an ETag matching the given","highlight_start":1,"highlight_end":78},{"text":"    /// ones. For other methods, the request will be processed only if the","highlight_start":1,"highlight_end":75},{"text":"    /// eventually existing resource's ETag doesn't match any of the values","highlight_start":1,"highlight_end":76},{"text":"    /// listed.","highlight_start":1,"highlight_end":16},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// When the condition fails for GET and HEAD methods, then the server must","highlight_start":1,"highlight_end":80},{"text":"    /// return HTTP status code 304 (Not Modified). For methods that apply","highlight_start":1,"highlight_end":75},{"text":"    /// server-side changes, the status code 412 (Precondition Failed) is used.","highlight_start":1,"highlight_end":80},{"text":"    /// Note that the server generating a 304 response MUST generate any of the","highlight_start":1,"highlight_end":80},{"text":"    /// following header fields that would have been sent in a 200 (OK) response","highlight_start":1,"highlight_end":81},{"text":"    /// to the same request: Cache-Control, Content-Location, Date, ETag,","highlight_start":1,"highlight_end":74},{"text":"    /// Expires, and Vary.","highlight_start":1,"highlight_end":27},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The comparison with the stored ETag uses the weak comparison algorithm,","highlight_start":1,"highlight_end":80},{"text":"    /// meaning two files are considered identical not only if they are","highlight_start":1,"highlight_end":72},{"text":"    /// identical byte to byte, but if the content is equivalent. For example,","highlight_start":1,"highlight_end":79},{"text":"    /// two pages that would differ only by the date of generation in the footer","highlight_start":1,"highlight_end":81},{"text":"    /// would be considered as identical.","highlight_start":1,"highlight_end":42},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// When used in combination with If-Modified-Since, it has precedence (if","highlight_start":1,"highlight_end":79},{"text":"    /// the server supports it).","highlight_start":1,"highlight_end":33},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// There are two common use cases:","highlight_start":1,"highlight_end":40},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * For `GET` and `HEAD` methods, to update a cached entity that has an associated ETag.","highlight_start":1,"highlight_end":95},{"text":"    /// * For other methods, and in particular for `PUT`, `If-None-Match` used with","highlight_start":1,"highlight_end":84},{"text":"    /// the `*` value can be used to save a file not known to exist,","highlight_start":1,"highlight_end":69},{"text":"    /// guaranteeing that another upload didn't happen before, losing the data","highlight_start":1,"highlight_end":79},{"text":"    /// of the previous put; this problems is the variation of the lost update","highlight_start":1,"highlight_end":79},{"text":"    /// problem.","highlight_start":1,"highlight_end":17},{"text":"    (IfNoneMatch, IF_NONE_MATCH, b\"if-none-match\");","highlight_start":1,"highlight_end":52},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Makes a request conditional based on range.","highlight_start":1,"highlight_end":52},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The If-Range HTTP request header makes a range request conditional: if","highlight_start":1,"highlight_end":79},{"text":"    /// the condition is fulfilled, the range request will be issued and the","highlight_start":1,"highlight_end":77},{"text":"    /// server sends back a 206 Partial Content answer with the appropriate","highlight_start":1,"highlight_end":76},{"text":"    /// body. If the condition is not fulfilled, the full resource is sent back,","highlight_start":1,"highlight_end":81},{"text":"    /// with a 200 OK status.","highlight_start":1,"highlight_end":30},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header can be used either with a Last-Modified validator, or with","highlight_start":1,"highlight_end":79},{"text":"    /// an ETag, but not with both.","highlight_start":1,"highlight_end":36},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The most common use case is to resume a download, to guarantee that the","highlight_start":1,"highlight_end":80},{"text":"    /// stored resource has not been modified since the last fragment has been","highlight_start":1,"highlight_end":79},{"text":"    /// received.","highlight_start":1,"highlight_end":18},{"text":"    (IfRange, IF_RANGE, b\"if-range\");","highlight_start":1,"highlight_end":38},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Makes the request conditional based on the last modification date.","highlight_start":1,"highlight_end":75},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The If-Unmodified-Since request HTTP header makes the request","highlight_start":1,"highlight_end":70},{"text":"    /// conditional: the server will send back the requested resource, or accept","highlight_start":1,"highlight_end":81},{"text":"    /// it in the case of a POST or another non-safe method, only if it has not","highlight_start":1,"highlight_end":80},{"text":"    /// been last modified after the given date. If the request has been","highlight_start":1,"highlight_end":73},{"text":"    /// modified after the given date, the response will be a 412 (Precondition","highlight_start":1,"highlight_end":80},{"text":"    /// Failed) error.","highlight_start":1,"highlight_end":23},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// There are two common use cases:","highlight_start":1,"highlight_end":40},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * In conjunction non-safe methods, like POST, it can be used to","highlight_start":1,"highlight_end":72},{"text":"    /// implement an optimistic concurrency control, like done by some wikis:","highlight_start":1,"highlight_end":78},{"text":"    /// editions are rejected if the stored document has been modified since the","highlight_start":1,"highlight_end":81},{"text":"    /// original has been retrieved.","highlight_start":1,"highlight_end":37},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * In conjunction with a range request with a If-Range header, it can be","highlight_start":1,"highlight_end":80},{"text":"    /// used to ensure that the new fragment requested comes from an unmodified","highlight_start":1,"highlight_end":80},{"text":"    /// document.","highlight_start":1,"highlight_end":18},{"text":"    (IfUnmodifiedSince, IF_UNMODIFIED_SINCE, b\"if-unmodified-since\");","highlight_start":1,"highlight_end":70},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// The Last-Modified header contains the date and time when the origin believes","highlight_start":1,"highlight_end":85},{"text":"    /// the resource was last modified.","highlight_start":1,"highlight_end":40},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The value is a valid Date/Time string defined in [RFC9910](https://datatracker.ietf.org/doc/html/rfc9110#section-5.6.7)","highlight_start":1,"highlight_end":128},{"text":"    (LastModified, LAST_MODIFIED, b\"last-modified\");","highlight_start":1,"highlight_end":53},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Allows the server to point an interested client to another resource","highlight_start":1,"highlight_end":76},{"text":"    /// containing metadata about the requested resource.","highlight_start":1,"highlight_end":58},{"text":"    (Link, LINK, b\"link\");","highlight_start":1,"highlight_end":27},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates the URL to redirect a page to.","highlight_start":1,"highlight_end":49},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The Location response header indicates the URL to redirect a page to. It","highlight_start":1,"highlight_end":81},{"text":"    /// only provides a meaning when served with a 3xx status response.","highlight_start":1,"highlight_end":72},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The HTTP method used to make the new request to fetch the page pointed","highlight_start":1,"highlight_end":79},{"text":"    /// to by Location depends of the original method and of the kind of","highlight_start":1,"highlight_end":73},{"text":"    /// redirection:","highlight_start":1,"highlight_end":21},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * If 303 (See Also) responses always lead to the use of a GET method,","highlight_start":1,"highlight_end":78},{"text":"    /// 307 (Temporary Redirect) and 308 (Permanent Redirect) don't change the","highlight_start":1,"highlight_end":79},{"text":"    /// method used in the original request;","highlight_start":1,"highlight_end":45},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// * 301 (Permanent Redirect) and 302 (Found) doesn't change the method","highlight_start":1,"highlight_end":77},{"text":"    /// most of the time, though older user-agents may (so you basically don't","highlight_start":1,"highlight_end":79},{"text":"    /// know).","highlight_start":1,"highlight_end":15},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// All responses with one of these status codes send a Location header.","highlight_start":1,"highlight_end":77},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Beside redirect response, messages with 201 (Created) status also","highlight_start":1,"highlight_end":74},{"text":"    /// include the Location header. It indicates the URL to the newly created","highlight_start":1,"highlight_end":79},{"text":"    /// resource.","highlight_start":1,"highlight_end":18},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Location and Content-Location are different: Location indicates the","highlight_start":1,"highlight_end":76},{"text":"    /// target of a redirection (or the URL of a newly created resource), while","highlight_start":1,"highlight_end":80},{"text":"    /// Content-Location indicates the direct URL to use to access the resource","highlight_start":1,"highlight_end":80},{"text":"    /// when content negotiation happened, without the need of further content","highlight_start":1,"highlight_end":79},{"text":"    /// negotiation. Location is a header associated with the response, while","highlight_start":1,"highlight_end":78},{"text":"    /// Content-Location is associated with the entity returned.","highlight_start":1,"highlight_end":65},{"text":"    (Location, LOCATION, b\"location\");","highlight_start":1,"highlight_end":39},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates the max number of intermediaries the request should be sent","highlight_start":1,"highlight_end":78},{"text":"    /// through.","highlight_start":1,"highlight_end":17},{"text":"    (MaxForwards, MAX_FORWARDS, b\"max-forwards\");","highlight_start":1,"highlight_end":50},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Indicates where a fetch originates from.","highlight_start":1,"highlight_end":49},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// It doesn't include any path information, but only the server name. It is","highlight_start":1,"highlight_end":81},{"text":"    /// sent with CORS requests, as well as with POST requests. It is similar to","highlight_start":1,"highlight_end":81},{"text":"    /// the Referer header, but, unlike this header, it doesn't disclose the","highlight_start":1,"highlight_end":77},{"text":"    /// whole path.","highlight_start":1,"highlight_end":20},{"text":"    (Origin, ORIGIN, b\"origin\");","highlight_start":1,"highlight_end":33},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// HTTP/1.0 header usually used for backwards compatibility.","highlight_start":1,"highlight_end":66},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The Pragma HTTP/1.0 general header is an implementation-specific header","highlight_start":1,"highlight_end":80},{"text":"    /// that may have various effects along the request-response chain. It is","highlight_start":1,"highlight_end":78},{"text":"    /// used for backwards compatibility with HTTP/1.0 caches where the","highlight_start":1,"highlight_end":72},{"text":"    /// Cache-Control HTTP/1.1 header is not yet present.","highlight_start":1,"highlight_end":58},{"text":"    (Pragma, PRAGMA, b\"pragma\");","highlight_start":1,"highlight_end":33},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Defines the authentication method that should be used to gain access to","highlight_start":1,"highlight_end":80},{"text":"    /// a proxy.","highlight_start":1,"highlight_end":17},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Unlike `www-authenticate`, the `proxy-authenticate` header field applies","highlight_start":1,"highlight_end":81},{"text":"    /// only to the next outbound client on the response chain. This is because","highlight_start":1,"highlight_end":80},{"text":"    /// only the client that chose a given proxy is likely to have the","highlight_start":1,"highlight_end":71},{"text":"    /// credentials necessary for authentication. However, when multiple proxies","highlight_start":1,"highlight_end":81},{"text":"    /// are used within the same administrative domain, such as office and","highlight_start":1,"highlight_end":75},{"text":"    /// regional caching proxies within a large corporate network, it is common","highlight_start":1,"highlight_end":80},{"text":"    /// for credentials to be generated by the user agent and passed through the","highlight_start":1,"highlight_end":81},{"text":"    /// hierarchy until consumed. Hence, in such a configuration, it will appear","highlight_start":1,"highlight_end":81},{"text":"    /// as if Proxy-Authenticate is being forwarded because each proxy will send","highlight_start":1,"highlight_end":81},{"text":"    /// the same challenge set.","highlight_start":1,"highlight_end":32},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// The `proxy-authenticate` header is sent along with a `407 Proxy","highlight_start":1,"highlight_end":72},{"text":"    /// Authentication Required`.","highlight_start":1,"highlight_end":34},{"text":"    (ProxyAuthenticate, PROXY_AUTHENTICATE, b\"proxy-authenticate\");","highlight_start":1,"highlight_end":68},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Contains the credentials to authenticate a user agent to a proxy server.","highlight_start":1,"highlight_end":81},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This header is usually included after the server has responded with a","highlight_start":1,"highlight_end":78},{"text":"    /// 407 Proxy Authentication Required status and the Proxy-Authenticate","highlight_start":1,"highlight_end":76},{"text":"    /// header.","highlight_start":1,"highlight_end":16},{"text":"    (ProxyAuthorization, PROXY_AUTHORIZATION, b\"proxy-authorization\");","highlight_start":1,"highlight_end":71},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Associates a specific cryptographic public key with a certain server.","highlight_start":1,"highlight_end":78},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// This decreases the risk of MITM attacks with forged certificates. If one","highlight_start":1,"highlight_end":81},{"text":"    /// or several keys are pinned and none of them are used by the server, the","highlight_start":1,"highlight_end":80},{"text":"    /// browser will not accept the response as legitimate, and will not display","highlight_start":1,"highlight_end":81},{"text":"    /// it.","highlight_start":1,"highlight_end":12},{"text":"    (PublicKeyPins, PUBLIC_KEY_PINS, b\"public-key-pins\");","highlight_start":1,"highlight_end":58},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    /// Sends reports of pinning violation to the report-uri specified in the","highlight_start":1,"highlight_end":78},{"text":"    /// header.","highlight_start":1,"highlight_end":16},{"text":"    ///","highlight_start":1,"highlight_end":8},{"text":"    /// Unlike `Public-Key-Pins`, this header still allows browsers to connect","highlight_start":1,"highlight_end":79},{"text":"    /// to the server if the pinning is violated.","highlight_start":1,"highlight_end":50},{"text":"    (PublicKeyPinsReportOnly, PUBLIC_KEY_PINS_REPORT_ONLY, b\"public-key-pins-report-only\");","highlight_start":1,"highlight_end":92}